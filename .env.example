# ─────────────────────────────────────────────────────────────────────────────
# InstaBiz ERP — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────


# ── PostgreSQL Database ───────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql+asyncpg://erp_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/adhesive_erp


# ── Application Security ──────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480


# ── CORS (comma-separated allowed origins) ────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com


# ── Debug Mode ────────────────────────────────────────────────────────────────
DEBUG=false


# ── AI / LLM Services ─────────────────────────────────────────────────────────
# Google Gemini — used for AI BI Dashboard, Smart Alerts, Buying DNA
GOOGLE_AI_API_KEY=

# EmergentIntegrations — wraps Gemini for structured AI outputs
EMERGENT_LLM_KEY=

# Anthropic Claude (optional future use)
ANTHROPIC_API_KEY=

# OpenAI (optional fallback)
OPENAI_API_KEY=


# ── GST / E-Invoice (NIC sandbox by default) ──────────────────────────────────
EINVOICE_API_URL=https://einv-apisandbox.nic.in
EINVOICE_API_USER=
EINVOICE_API_PASS=


# ── WhatsApp Business API ─────────────────────────────────────────────────────
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=


# ── AWS S3 (for document/file storage) ───────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_S3_BUCKET=


# ── Stripe (optional payment integration) ────────────────────────────────────
STRIPE_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# ERPNext Integration (instabiz-develop — Frappe v15, site: frontend)
# This is the MASTER database. FastAPI reads MariaDB directly and writes
# through the ERPNext REST API so all hooks, validators, and GST logic fire.
# ─────────────────────────────────────────────────────────────────────────────

# ERPNext REST API base URL (same server → localhost)
ERPNEXT_URL=http://localhost:8000

# API credentials — generate in ERPNext: Settings → Users → {user} → API Access → Generate Keys
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# MariaDB direct connection (ERPNext site DB — read-only use recommended)
# Site config is at: /home/dev/frappe-bench/sites/frontend/site_config.json
# Keys: db_host, db_name (=frontend), db_password
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_DB=frontend
MARIADB_USER=root
MARIADB_PASSWORD=

# ERPNext site name (used for bench commands)
ERPNEXT_SITE=frontend


# ── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=/tmp/erp_uploads
MAX_UPLOAD_SIZE=10485760    # 10 MB in bytes


# ─────────────────────────────────────────────────────────────────────────────
# DEFAULT TEST CREDENTIALS (seed_data.py — remove in production)
# Email:    admin@instabiz.com
# Password: adminpassword
# ─────────────────────────────────────────────────────────────────────────────
